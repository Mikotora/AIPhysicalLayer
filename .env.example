# Mock is the default. Change to nature only after the token and local binding file are set.
ADAPTER_MODE=mock

# Never paste these values into chat or commit them to Git.
NATURE_ACCESS_TOKEN=
NATURE_BINDINGS_FILE=config/nature-bindings.json

# Optional. Points to a mode-0600 JSON file containing only client IDs and SHA-256 key hashes.
# Keep the real file untracked. The example file is not an active credential store.
AI_CLIENT_KEYS_FILE=
